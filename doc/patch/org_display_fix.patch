-       .filter((org) => org.path === parentPath)
-       .map((item) => {
-         return {
+     // 尝试按照path字段匹配的组织
+     const matchedOrgs = orgs.filter((org) => org.path === parentPath);
+     
+     // 如果没有匹配到组织，但数据存在，则显示所有组织
+     if (matchedOrgs.length === 0 && parentPath !== '') {
+       return orgs.map((item) => ({
+         ...item,
+         count: (item.members?.length || 0) + 
+                orgs.filter((org) => org.path === getOrgChildrenPath(item)).length
+       }));
+     }
+ 
+     return matchedOrgs.map((item) => ({
        ...item,
-           // Member + org
-           count:
-             item.members.length + orgs.filter((org) => org.path === getOrgChildrenPath(item)).length
-         };
-       });
+       count: (item.members?.length || 0) + 
+              orgs.filter((org) => org.path === getOrgChildrenPath(item)).length
+     }));
```

